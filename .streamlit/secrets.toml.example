# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Cloud -> App settings -> Secrets. Only the first key is required.
GEMINI_API_KEY = "your-free-key-from-aistudio.google.com"

# Recommended: a second provider as backup. Free tiers have small per-model daily
# quotas; if every Gemini model fails, the app falls back to Groq automatically.
# Free key, no card: https://console.groq.com/keys
# GROQ_API_KEY = "gsk_..."

# Optional: switch the main provider / models (comma-separated: primary, then fallbacks)
# LLM_PROVIDER = "groq"
# LLM_MODELS = "gemini-3-flash-preview, gemini-3.1-flash-lite"

# Unlocks every visitor's traces on the Traces page (visitors only see their own).
# ADMIN_PASSWORD = "choose-a-long-random-password"

# Optional: long-term observability in Langfuse (free Hobby plan)
# LANGFUSE_PUBLIC_KEY = "pk-lf-..."
# LANGFUSE_SECRET_KEY = "sk-lf-..."
# LANGFUSE_HOST = "https://cloud.langfuse.com"   # or https://us.cloud.langfuse.com
