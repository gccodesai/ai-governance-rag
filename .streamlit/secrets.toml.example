# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Cloud -> App settings -> Secrets. Only the first key is required.
GEMINI_API_KEY = "your-free-key-from-aistudio.google.com"

# Optional: switch provider / models (comma-separated: primary, then fallbacks)
# LLM_PROVIDER = "groq"
# GROQ_API_KEY = "gsk_..."
# LLM_MODELS = "gemini-3-flash-preview, gemini-3.1-flash-lite"

# Optional: long-term observability in Langfuse (free Hobby plan)
# LANGFUSE_PUBLIC_KEY = "pk-lf-..."
# LANGFUSE_SECRET_KEY = "sk-lf-..."
# LANGFUSE_HOST = "https://cloud.langfuse.com"   # or https://us.cloud.langfuse.com
